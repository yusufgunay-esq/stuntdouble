{
  "name": "stuntdouble",
  "private": true,
  "description": "Stuntdouble monorepo: reference TS kernel + C# / C++ / Lua ports kept in lockstep by the conformance suite.",
  "keywords": [
    "game-ai",
    "goap",
    "utility-ai",
    "single-player",
    "game-modding",
    "reverse-engineering",
    "ai-agent",
    "agent-skill",
    "combat-ai",
    "autoplay",
    "accessibility",
    "typescript",
    "csharp",
    "cpp",
    "lua"
  ],
  "license": "MPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test:ts": "node --experimental-strip-types --test packages/stuntdouble-brain-ts/tests/brain.test.ts",
    "validate": "node scripts/validate-profiles.mjs",
    "fixtures:gen": "node --experimental-strip-types packages/conformance/emit-reference.mjs && node --experimental-strip-types packages/conformance/gen-fixtures.mjs",
    "fixtures:check": "node scripts/check-fixtures-fresh.mjs",
    "conformance:cs": "node scripts/run-conformance.mjs cs",
    "conformance:cpp": "node scripts/run-conformance.mjs cpp",
    "conformance:lua": "node scripts/run-conformance.mjs lua",
    "conformance:all": "npm run fixtures:check && node scripts/run-conformance.mjs all",
    "test": "npm run test:ts && npm run test:seams && npm run test:arena && node packages/stuntdouble-arena/run.mjs && npm run validate && npm run fixtures:check && node scripts/run-conformance.mjs cs --optional",
    "test:seams": "node --experimental-strip-types --test packages/stuntdouble-seams-ts/tests/runtime.test.ts",
    "test:arena": "node --experimental-strip-types --test packages/stuntdouble-arena/tests/arena.test.ts",
    "arena": "node packages/stuntdouble-arena/run.mjs"
  }
}
